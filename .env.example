# Copy this file to ".env" for local work (Windows: copy .env.example .env).
# On Cloudflare, add the same names under Settings > Environment variables instead.
# Everything here ends up in the public website, so only use the PUBLIC (anon / publishable) Supabase key.
# NEVER put the "service_role" key anywhere in this project.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# Already set in the code, so only use these to change them
VITE_CONTACT_EMAIL=haoyangurealtors@gmail.com
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_TWITTER_URL=
VITE_YOUTUBE_URL=
VITE_TIKTOK_URL=

# Optional extras (see the launch guide, Phases 16 and 17)
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=
VITE_FEATURED_PRICING=
