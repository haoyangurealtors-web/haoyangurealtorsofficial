# Copy this file to ".env" for local work (Windows: copy .env.example .env).
# On Cloudflare, add the same names under Settings > Environment variables instead.
# Everything here ends up in the public website, so only use the PUBLIC (anon / publishable) Supabase key.
# NEVER put the "service_role" key anywhere in this project.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# Already set in the code, so only use these to change them
VITE_CONTACT_EMAIL=haoyangurealtors@gmail.com
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_TWITTER_URL=
VITE_YOUTUBE_URL=
VITE_TIKTOK_URL=

# Optional extras (see the launch guide, Phases 16 and 17)
VITE_SENTRY_DSN=
VITE_FEATURED_PRICING=

# AI support assistant (see README, "AI support assistant"). It is FREE: it runs on Cloudflare Workers AI.
# On the live site there is nothing to put here: you add a "Workers AI" binding named AI in Cloudflare Pages instead (no key needed).
# The two lines below are ONLY for testing the chat on your laptop with "npm run dev".
# They are SERVER-ONLY settings: they must NEVER start with VITE_, because anything starting with VITE_ is published inside the website.
# CF_ACCOUNT_ID: Cloudflare dashboard > Workers & Pages (right-hand side). CF_API_TOKEN: My Profile > API Tokens > Create Token > "Workers AI" template.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CHAT_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
